# Copy to repository-root .env.production; replace placeholders and protect the file.
PUBLIC_ORIGIN=https://builder.example.com
DATABASE_URL=postgres://builder:REPLACE_WITH_SECRET@db.example.com:5432/builder?sslmode=require
DB_POOL_MAX=10
S3_BUCKET=private-builder-assets
S3_REGION=us-east-1
# Omit S3_ENDPOINT for AWS S3; set a private endpoint for another S3-compatible service.
S3_ENDPOINT=
# Prefer workload identity. Set both values only if your provider requires static credentials.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

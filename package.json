{
  "name": "drag-drop-design",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,editor \"npm run dev -w @builder/api\" \"npm run dev -w @builder/editor\"",
    "test": "node --test packages/document/test/*.test.js",
    "test:api": "npm run test -w @builder/api",
    "test:editor": "node --test apps/editor/test/*.test.js",
    "build": "npm run build -w @builder/editor",
    "verify:exports": "node scripts/verify-exports.js",
    "export:sample": "node packages/exporters/src/export-sample.js"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "playwright-core": "^1.63.0"
  }
}
